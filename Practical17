import numpy as np
from scipy import stats

data = [42, 45, 47, 44, 46, 48, 43, 45, 47, 44]

test_mean = 45
significance_level = 0.05

t_statistic, p_value = stats.ttest_1samp(data, test_mean)

print("One Sample T-Test")
print("T-statistic:", round(t_statistic, 4))
print("P-value:", round(p_value, 4))
print("Significance Level:", significance_level)

if p_value < significance_level:
    print("Reject the Null Hypothesis")
    print("There is a significant difference from the assumed mean.")
else:
    print("Fail to Reject the Null Hypothesis")
    print("There is no significant difference from the assumed mean.")
