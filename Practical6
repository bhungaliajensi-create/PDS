# 1. try and except
print("Try-Except Example:")

try:
    a = 10
    b = 0
    result = a / b
    print("Result:", result)

except ZeroDivisionError:
    print("Error: Cannot divide by zero")


# 2. try, except and else
print("\nTry-Except-Else Example:")

try:
    number = int(input("Enter a number:"))
    result = 100 / number

except ValueError:
    print("Error: Please enter a valid number")

except ZeroDivisionError:
    print("Error: Cannot divide by zero")

else:
    print("Result:", result)


# 3. finally block
print("\nFinally Example:")

try:
    file = open("sample.txt", "r")
    print(file.read())

except FileNotFoundError:
    print("Error: File not found")

finally:
    print("Finally block is always executed")


# 4. raise statement
print("\nRaise Example:")

age = 15

try:
    if age < 18:
        raise ValueError("Age must be 18 or above")
    print("Eligible")

except ValueError as e:
    print("Error:", e)


# 5. Custom Exception
print("\nCustom Exception Example:")

class NegativeNumberError(Exception):
    pass


try:
    number = -10

    if number < 0:
        raise NegativeNumberError("Negative number is not allowed")

    print("Number:", number)

except NegativeNumberError as e:
    print("Custom Error:", e)

finally:
    print("Program completed")
