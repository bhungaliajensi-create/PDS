import pandas as pd

data1 = {
    "Name": ["Jensi", "Rahul", "Amit", "Priya"],
    "Age": [20, 21, 22, 20],
    "Marks": [85, 90, 78, 88]
}

data2 = {
    "Name": ["Neha", "Karan"],
    "Age": [21, 22],
    "Marks": [92, 80]
}

df1 = pd.DataFrame(data1)
df2 = pd.DataFrame(data2)

print("Original Data:")
print(df1)

print("\nSlicing:")
print(df1.iloc[0:3])

print("\nFiltering:")
print(df1[df1["Marks"] > 80])

print("\nSorting:")
print(df1.sort_values(by="Marks", ascending=False))

print("\nConcatenating:")
df = pd.concat([df1, df2], ignore_index=True)
print(df)

print("\nAggregating:")
print("Average Marks:", df["Marks"].mean())
print("Maximum Marks:", df["Marks"].max())
print("Minimum Marks:", df["Marks"].min())
print("Total Marks:", df["Marks"].sum())

print("\nNormalized Marks:")
df["Normalized_Marks"] = (
    (df["Marks"] - df["Marks"].min()) /
    (df["Marks"].max() - df["Marks"].min())
)

print(df)
